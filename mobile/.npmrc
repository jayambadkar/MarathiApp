# React Native 0.88 is an RC; its prerelease version string is semver-excluded
# from libraries' advisory peer ranges (e.g. reanimated "0.86 - 0.88").
# 0.88 is declared non-breaking vs 0.87, so accept the tree and verify by
# building: tsc + jest + Metro bundle + Gradle assembleDebug.
legacy-peer-deps=true
